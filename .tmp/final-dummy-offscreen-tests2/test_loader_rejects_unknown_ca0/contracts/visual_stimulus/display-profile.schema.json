        "refresh_numerator": {
          "exclusiveMinimum": 0,
          "title": "Refresh Numerator",
          "type": "integer"
        },
        "refresh_denominator": {
          "exclusiveMinimum": 0,
          "title": "Refresh Denominator",
          "type": "integer"
        },
        "rgb_bits_per_channel": {
          "enum": [
            8,
            10
