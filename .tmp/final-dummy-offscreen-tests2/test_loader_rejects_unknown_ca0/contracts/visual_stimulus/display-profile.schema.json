          "minItems": 4,
          "title": "Surfaces",
          "type": "array"
        }
      },
      "required": [
        "frame_id",
        "observer_mm",
        "near_mm",
        "far_mm",
        "positional_tolerance_mm",
        "orthogonality_tolerance",
        "surfaces"
      ],
      "title": "Geometry",
      "type": "object"
