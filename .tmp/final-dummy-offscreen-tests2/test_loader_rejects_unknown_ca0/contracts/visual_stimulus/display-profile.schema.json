        "surface_id": {
          "enum": [
            "front",
            "left",
            "right",
            "bottom"
          ],
          "title": "Surface Id",
          "type": "string"
        },
        "output_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Output Id",
          "type": "string"
        },
        "viewport": {
          "$ref": "#/$defs/PixelRect"
        },
        "geometric_profile": {
