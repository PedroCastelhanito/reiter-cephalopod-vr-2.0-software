    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "logical_path": {
          "minLength": 1,
          "title": "Logical Path",
          "type": "string"
        }
      },
      "required": [
        "logical_path"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "Geometry": {
      "additionalProperties": false,
      "properties": {
        "frame_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Frame Id",
          "type": "string"
        },
        "observer_mm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Observer Mm",
          "type": "array"
        },
        "near_mm": {
          "exclusiveMinimum": 0,
          "title": "Near Mm",
          "type": "number"
        },
        "far_mm": {
          "exclusiveMinimum": 0,
          "title": "Far Mm",
          "type": "number"
        },
        "positional_tolerance_mm": {
          "exclusiveMinimum": 0,
          "title": "Positional Tolerance Mm",
          "type": "number"
        },
        "orthogonality_tolerance": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Orthogonality Tolerance",
          "type": "number"
