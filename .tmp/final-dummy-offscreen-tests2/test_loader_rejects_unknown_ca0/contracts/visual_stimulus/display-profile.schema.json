            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bottom Left Mm",
          "type": "array"
        },
        "bottom_right_mm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bottom Right Mm",
          "type": "array"
        },
        "top_right_mm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Top Right Mm",
          "type": "array"
        },
        "top_left_mm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Top Left Mm",
          "type": "array"
        }
