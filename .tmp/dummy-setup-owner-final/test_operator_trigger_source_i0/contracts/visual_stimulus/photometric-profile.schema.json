{
  "$defs": {
    "MeasurementProvenance": {
      "additionalProperties": false,
      "properties": {
        "measurement_id": {
          "minLength": 1,
          "title": "Measurement Id",
          "type": "string"
        },
        "measured_at": {
          "minLength": 1,
          "title": "Measured At",
          "type": "string"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "instrument": {
          "minLength": 1,
          "title": "Instrument",
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        }
      },
      "required": [
        "measurement_id",
        "measured_at",
        "method",
        "instrument",
        "reference"
      ],
      "title": "MeasurementProvenance",
      "type": "object"
    },
    "OperatingCondition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "OperatingCondition",
      "type": "object"
    },
    "OutputBinding": {
      "additionalProperties": false,
      "properties": {
        "output_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Output Id",
          "type": "string"
        },
        "device_identity": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Device Identity",
          "type": "string"
        },
        "width_px": {
          "exclusiveMinimum": 0,
          "title": "Width Px",
          "type": "integer"
        },
        "height_px": {
          "exclusiveMinimum": 0,
          "title": "Height Px",
          "type": "integer"
        },
        "refresh_numerator": {
          "exclusiveMinimum": 0,
          "title": "Refresh Numerator",
          "type": "integer"
        },
        "refresh_denominator": {
          "exclusiveMinimum": 0,
          "title": "Refresh Denominator",
          "type": "integer"
        },
        "rgb_bits": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            }
          ],
          "title": "Rgb Bits",
          "type": "array"
        },
        "signal_encoding": {
          "const": "full_range_rgb_device_codes",
          "title": "Signal Encoding",
          "type": "string"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/OperatingCondition"
          },
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "output_id",
        "device_identity",
        "width_px",
        "height_px",
        "refresh_numerator",
        "refresh_denominator",
        "rgb_bits",
        "signal_encoding",
        "conditions"
      ],
      "title": "OutputBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "model": {
      "const": "per_channel_measured_inverse_lut_v1",
      "title": "Model",
      "type": "string"
    },
    "working_space": {
      "const": "linear_rec709_d65_relative",
      "title": "Working Space",
      "type": "string"
    },
    "normalization": {
      "const": "per_channel_measured_black_to_white",
      "title": "Normalization",
      "type": "string"
    },
    "interpolation": {
      "const": "piecewise_linear_uniform_input_grid",
      "title": "Interpolation",
      "type": "string"
    },
    "output": {
      "$ref": "#/$defs/OutputBinding"
    },
    "measurement": {
      "$ref": "#/$defs/MeasurementProvenance"
    },
    "red": {
      "items": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "minItems": 2,
      "title": "Red",
      "type": "array"
    },
    "green": {
      "items": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "minItems": 2,
      "title": "Green",
      "type": "array"
    },
    "blue": {
      "items": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "minItems": 2,
      "title": "Blue",
      "type": "array"
    }
  },
  "required": [
    "format_version",
    "profile_id",
    "model",
    "working_space",
    "normalization",
    "interpolation",
    "output",
    "measurement",
    "red",
    "green",
    "blue"
  ],
  "title": "PhotometricProfile",
  "type": "object"
}
