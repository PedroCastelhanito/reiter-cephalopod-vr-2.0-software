{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        }
      },
      "required": [
        "relative_path"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "adapter": {
      "const": "onnx_triplet_v1",
      "title": "Adapter",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/Asset"
    },
    "external_weights": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "External Weights",
      "type": "array"
    },
    "input_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Input Name",
      "type": "string"
    },
    "output_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Output Name",
      "type": "string"
    },
    "input_width_px": {
      "exclusiveMinimum": 0,
      "maximum": 4294967295,
      "title": "Input Width Px",
      "type": "integer"
    },
    "input_height_px": {
      "exclusiveMinimum": 0,
      "maximum": 4294967295,
      "title": "Input Height Px",
      "type": "integer"
    },
    "channels": {
      "enum": [
        "gray",
        "rgb"
      ],
      "title": "Channels",
      "type": "string"
    },
    "mean": {
      "items": {
        "type": "number"
      },
      "title": "Mean",
      "type": "array"
    },
    "std": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "title": "Std",
      "type": "array"
    },
    "padding_source_fraction": {
      "items": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "title": "Padding Source Fraction",
      "type": "array"
    },
    "maximum_candidates": {
      "exclusiveMinimum": 0,
      "maximum": 4294967295,
      "title": "Maximum Candidates",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "adapter",
    "model",
    "external_weights",
    "input_name",
    "output_name",
    "input_width_px",
    "input_height_px",
    "channels",
    "mean",
    "std",
    "padding_source_fraction",
    "maximum_candidates"
  ],
  "title": "ModelManifest",
  "type": "object"
}
