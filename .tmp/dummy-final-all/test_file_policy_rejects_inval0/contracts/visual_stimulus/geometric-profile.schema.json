{
  "$defs": {
    "Grid": {
      "additionalProperties": false,
      "properties": {
        "rows": {
          "minimum": 2,
          "title": "Rows",
          "type": "integer"
        },
        "columns": {
          "minimum": 2,
          "title": "Columns",
          "type": "integer"
        },
        "values": {
          "items": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "title": "Values",
          "type": "array"
        },
        "sampling": {
          "const": "bilinear",
          "title": "Sampling",
          "type": "string"
        }
      },
      "required": [
        "rows",
        "columns",
        "values",
        "sampling"
      ],
      "title": "Grid",
      "type": "object"
    },
    "PixelRect": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "PixelRect",
      "type": "object"
    },
    "Vertex": {
      "additionalProperties": false,
      "properties": {
        "uv": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            }
          ],
          "title": "Uv",
          "type": "array"
        },
        "xy": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            }
          ],
          "title": "Xy",
          "type": "array"
        }
      },
      "required": [
        "uv",
        "xy"
      ],
      "title": "Vertex",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "calibration_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Calibration Id",
      "type": "string"
    },
    "mapping_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Mapping Id",
      "type": "string"
    },
    "surface_id": {
      "enum": [
        "front",
        "left",
        "right",
        "bottom"
      ],
      "title": "Surface Id",
      "type": "string"
    },
    "output_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Output Id",
      "type": "string"
    },
    "output_width": {
      "exclusiveMinimum": 0,
      "title": "Output Width",
      "type": "integer"
    },
    "output_height": {
      "exclusiveMinimum": 0,
      "title": "Output Height",
      "type": "integer"
    },
    "viewport": {
      "$ref": "#/$defs/PixelRect"
    },
    "rows": {
      "minimum": 2,
      "title": "Rows",
      "type": "integer"
    },
    "columns": {
      "minimum": 2,
      "title": "Columns",
      "type": "integer"
    },
    "vertices": {
      "items": {
        "$ref": "#/$defs/Vertex"
      },
      "title": "Vertices",
      "type": "array"
    },
    "orientation": {
      "enum": [
        "preserving",
        "mirrored"
      ],
      "title": "Orientation",
      "type": "string"
    },
    "diagonal": {
      "const": "bottom_left_to_top_right",
      "title": "Diagonal",
      "type": "string"
    },
    "mask": {
      "anyOf": [
        {
          "$ref": "#/$defs/Grid"
        },
        {
          "type": "null"
        }
      ]
    },
    "weight": {
      "anyOf": [
        {
          "$ref": "#/$defs/Grid"
        },
        {
          "type": "null"
        }
      ]
    },
    "overlap_group": {
      "anyOf": [
        {
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Overlap Group"
    },
    "intended_coverage": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          }
        ],
        "type": "array"
      },
      "minItems": 3,
      "title": "Intended Coverage",
      "type": "array"
    },
    "coverage_tolerance": {
      "exclusiveMinimum": 0,
      "title": "Coverage Tolerance",
      "type": "number"
    },
    "triangle_area_tolerance": {
      "exclusiveMinimum": 0,
      "title": "Triangle Area Tolerance",
      "type": "number"
    }
  },
  "required": [
    "format_version",
    "calibration_id",
    "mapping_id",
    "surface_id",
    "output_id",
    "output_width",
    "output_height",
    "viewport",
    "rows",
    "columns",
    "vertices",
    "orientation",
    "diagonal",
    "mask",
    "weight",
    "overlap_group",
    "intended_coverage",
    "coverage_tolerance",
    "triangle_area_tolerance"
  ],
  "title": "GeometricProfile",
  "type": "object"
}
