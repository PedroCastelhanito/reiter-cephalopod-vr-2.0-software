{
  "$defs": {
    "ArenaBoundary": {
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Instance Id",
          "type": "string"
        },
        "world_frame_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "World Frame Id",
          "type": "string"
        },
        "region": {
          "discriminator": {
            "mapping": {
              "convex_polygon_xy": "#/$defs/ConvexPolygon",
              "unrestricted": "#/$defs/UnrestrictedRegion"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/UnrestrictedRegion"
            },
            {
              "$ref": "#/$defs/ConvexPolygon"
            }
          ],
          "title": "Region"
        }
      },
      "required": [
        "instance_id",
        "world_frame_id",
        "region"
      ],
      "title": "ArenaBoundary",
      "type": "object"
    },
    "ConvexPolygon": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "convex_polygon_xy",
          "title": "Kind",
          "type": "string"
        },
        "vertices_mm": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 3,
          "title": "Vertices Mm",
          "type": "array"
        },
        "margin_mm": {
          "minimum": 0,
          "title": "Margin Mm",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "vertices_mm",
        "margin_mm"
      ],
      "title": "ConvexPolygon",
      "type": "object"
    },
    "UnrestrictedRegion": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unrestricted",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "UnrestrictedRegion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "bindings": {
      "items": {
        "$ref": "#/$defs/ArenaBoundary"
      },
      "title": "Bindings",
      "type": "array"
    }
  },
  "required": [
    "format_version",
    "bindings"
  ],
  "title": "TrialArenaBoundaries",
  "type": "object"
}
