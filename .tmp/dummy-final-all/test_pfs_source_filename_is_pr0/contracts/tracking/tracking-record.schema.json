{
  "$defs": {
    "Completion": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "completion",
          "title": "Kind",
          "type": "string"
        },
        "cutoff_host_ns": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Cutoff Host Ns",
          "type": "integer"
        },
        "outcome": {
          "enum": [
            "completed",
            "interrupted"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "pose_records": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Pose Records",
          "type": "integer"
        },
        "result_records": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Result Records",
          "type": "integer"
        },
        "reset_records": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Reset Records",
          "type": "integer"
        },
        "discard_records": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Discard Records",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "cutoff_host_ns",
        "outcome",
        "pose_records",
        "result_records",
        "reset_records",
        "discard_records"
      ],
      "title": "Completion",
      "type": "object"
    },
    "Discard": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "discard",
          "title": "Kind",
          "type": "string"
        },
        "reset_generation": {
          "title": "Reset Generation",
          "type": "string"
        },
        "observed_host_ns": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Observed Host Ns",
          "type": "integer"
        },
        "target": {
          "enum": [
            "source_frame",
            "result"
          ],
          "title": "Target",
          "type": "string"
        },
        "ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Ids",
          "type": "array"
        },
        "reason": {
          "enum": [
            "camera_gap",
            "input_age",
            "input_overflow",
            "result_overflow",
            "retired_generation",
            "trial_cutoff"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reset_generation",
        "observed_host_ns",
        "target",
        "ids",
        "reason"
      ],
      "title": "Discard",
      "type": "object"
    },
    "Header": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "header",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "stream_kind": {
          "const": "tracking",
          "title": "Stream Kind",
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "trial_start_host_ns": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Trial Start Host Ns",
          "type": "integer"
        },
        "trial_normal_end_host_ns": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Trial Normal End Host Ns",
          "type": "integer"
        },
        "pipeline_id": {
          "enum": [
            "water_flow",
            "fin_flow"
          ],
          "title": "Pipeline Id",
          "type": "string"
        },
        "pose_mode": {
          "enum": [
            "manual",
            "automatic"
          ],
          "title": "Pose Mode",
          "type": "string"
        },
        "prepared_methods_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prepared Methods Sha256",
          "type": "string"
        },
        "prepared_methods_json": {
          "title": "Prepared Methods Json",
          "type": "string"
        },
        "resolved_settings_json": {
          "title": "Resolved Settings Json",
          "type": "string"
        },
        "image_width_px": {
          "exclusiveMinimum": 0,
          "maximum": 4294967295,
          "title": "Image Width Px",
          "type": "integer"
        },
        "image_height_px": {
          "exclusiveMinimum": 0,
          "maximum": 4294967295,
          "title": "Image Height Px",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "stream_kind",
        "identity",
        "trial_start_host_ns",
        "trial_normal_end_host_ns",
        "pipeline_id",
        "pose_mode",
        "prepared_methods_sha256",
        "prepared_methods_json",
        "resolved_settings_json",
        "image_width_px",
        "image_height_px"
      ],
      "title": "Header",
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Session Id",
          "type": "string"
        },
        "trial_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Trial Id",
          "type": "string"
        },
        "tracking_process_instance_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Tracking Process Instance Id",
          "type": "string"
        },
        "writer_generation": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Writer Generation",
          "type": "string"
        },
        "configuration_revision": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Configuration Revision",
          "type": "integer"
        },
        "prepared_generation": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Prepared Generation",
          "type": "string"
        },
        "source_allocation_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Source Allocation Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "trial_id",
        "tracking_process_instance_id",
        "writer_generation",
        "configuration_revision",
        "prepared_generation",
        "source_allocation_id"
      ],
      "title": "Identity",
      "type": "object"
    },
    "MovementResult": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "result",
          "title": "Kind",
          "type": "string"
        },
        "feedback_result": {
          "title": "Feedback Result",
          "type": "object"
        },
        "produced_host_ns": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Produced Host Ns",
          "type": "integer"
        },
        "pose": {
          "$ref": "#/$defs/PoseUse"
        },
        "stage_evidence": {
          "items": {
            "$ref": "#/$defs/StageEvidence"
          },
          "title": "Stage Evidence",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "feedback_result",
        "produced_host_ns",
        "pose",
        "stage_evidence"
      ],
      "title": "MovementResult",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x_px": {
          "minimum": 0,
          "title": "X Px",
          "type": "number"
        },
        "y_px": {
          "minimum": 0,
          "title": "Y Px",
          "type": "number"
        }
      },
      "required": [
        "x_px",
        "y_px"
      ],
      "title": "Point",
      "type": "object"
    },
    "PoseObservation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pose",
          "title": "Kind",
          "type": "string"
        },
        "observation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "reset_generation": {
          "title": "Reset Generation",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceFrame"
        },
        "completion_host_ns": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Completion Host Ns",
          "type": "integer"
        },
        "method": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "validity": {
          "enum": [
            "valid",
            "invalid"
          ],
          "title": "Validity",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "landmarks": {
          "anyOf": [
            {
              "$ref": "#/$defs/Triplet"
            },
            {
              "type": "null"
            }
          ]
        },
        "eligible_candidate_count": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Eligible Candidate Count",
          "type": "integer"
        },
        "selected_score": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected Score"
        },
        "top_score_tie": {
          "title": "Top Score Tie",
          "type": "boolean"
        },
        "disposition": {
          "enum": [
            "published",
            "retired_generation",
            "cutoff_excluded"
          ],
          "title": "Disposition",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "observation_id",
        "reset_generation",
        "source",
        "completion_host_ns",
        "method",
        "validity",
        "reason",
        "landmarks",
        "eligible_candidate_count",
        "selected_score",
        "top_score_tie",
        "disposition"
      ],
      "title": "PoseObservation",
      "type": "object"
    },
    "PoseUse": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "manual",
            "valid",
            "missing",
            "invalid",
            "stale"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "observation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observation Id"
        },
        "manual_geometry_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Manual Geometry Id"
        },
        "check_host_ns": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Check Host Ns",
          "type": "integer"
        },
        "pose_source_host_ns": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pose Source Host Ns"
        },
        "age_ns": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Age Ns"
        },
        "maximum_age_ns": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 9223372036854775807,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maximum Age Ns"
        }
      },
      "required": [
        "disposition",
        "observation_id",
        "manual_geometry_id",
        "check_host_ns",
        "pose_source_host_ns",
        "age_ns",
        "maximum_age_ns"
      ],
      "title": "PoseUse",
      "type": "object"
    },
    "Reset": {
      "additionalProperties": false,
      "description": "A06: one line per reset, before any result carrying its generation.",
      "properties": {
        "kind": {
          "const": "reset",
          "title": "Kind",
          "type": "string"
        },
        "reset_generation": {
          "title": "Reset Generation",
          "type": "string"
        },
        "causes": {
          "items": {
            "enum": [
              "trial_start",
              "camera_gap",
              "input_age",
              "input_overflow",
              "result_overflow"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Causes",
          "type": "array"
        },
        "observed_host_ns": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Observed Host Ns",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "reset_generation",
        "causes",
        "observed_host_ns"
      ],
      "title": "Reset",
      "type": "object"
    },
    "SourceFrame": {
      "additionalProperties": false,
      "properties": {
        "frame_id": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Frame Id",
          "type": "integer"
        },
        "host_receipt_ns": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Host Receipt Ns",
          "type": "integer"
        }
      },
      "required": [
        "frame_id",
        "host_receipt_ns"
      ],
      "title": "SourceFrame",
      "type": "object"
    },
    "StageEvidence": {
      "additionalProperties": false,
      "properties": {
        "stage_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Stage Id",
          "type": "string"
        },
        "schema_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Schema Id",
          "type": "string"
        },
        "payload": {
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "stage_id",
        "schema_id",
        "payload"
      ],
      "title": "StageEvidence",
      "type": "object"
    },
    "Triplet": {
      "additionalProperties": false,
      "properties": {
        "tip": {
          "$ref": "#/$defs/Point"
        },
        "left_base": {
          "$ref": "#/$defs/Point"
        },
        "right_base": {
          "$ref": "#/$defs/Point"
        }
      },
      "required": [
        "tip",
        "left_base",
        "right_base"
      ],
      "title": "Triplet",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "record": {
      "discriminator": {
        "mapping": {
          "completion": "#/$defs/Completion",
          "discard": "#/$defs/Discard",
          "header": "#/$defs/Header",
          "pose": "#/$defs/PoseObservation",
          "reset": "#/$defs/Reset",
          "result": "#/$defs/MovementResult"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Header"
        },
        {
          "$ref": "#/$defs/PoseObservation"
        },
        {
          "$ref": "#/$defs/MovementResult"
        },
        {
          "$ref": "#/$defs/Reset"
        },
        {
          "$ref": "#/$defs/Discard"
        },
        {
          "$ref": "#/$defs/Completion"
        }
      ],
      "title": "Record"
    }
  },
  "required": [
    "record"
  ],
  "title": "TrackingRecord",
  "type": "object"
}
