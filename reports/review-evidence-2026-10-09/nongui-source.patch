+    async def plan(actual: wire.PlanLaunchRequest) -> wire.LaunchState:
+        assert actual == request
+        order.append(("plan", expected_deadline))
+        return plan_state
+
+    def make_pipes() -> worker_launch.BootstrapPipeHandles:
+        order.append("pipes")
