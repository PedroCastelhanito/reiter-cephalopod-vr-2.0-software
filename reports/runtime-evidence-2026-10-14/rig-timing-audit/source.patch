+        assert (
+            panel.calibration_files.calibration_snapshot()["values"][
+                "screens.Front.reference_x_mm"
+            ]
+            == 123.5
+        )
+    panel.set_calibration_presentation_state(
+        active=True, available=True, pending=True, view=view
+    )
