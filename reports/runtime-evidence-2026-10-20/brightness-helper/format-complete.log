644  + @pytest.mark.parametrize("source_kind", ["hex", "ino"])
645  + async def test_general_microcontroller_commands_and_upload_work_without_acquisition_backend(
646  +     controller, tmp_path, source_kind
647  + ):
648  +     from cephvr.controller.microcontroller.firmware import read_uno_image
649  +     from cephvr.controller.microcontroller.firmware_source import read_firmware
650  +
651  +     port, store, runtime = controller
652  +     events = []
653  +     image_path = tmp_path / "compiled.hex"
654  +     image_path.write_bytes(b":0400000001020304F2\n:00000001FF\n")
655  +     image = read_uno_image(str(image_path))
656  +     path = tmp_path / f"source.{source_kind}"
657  +     path.write_bytes(
658  +         b"void setup() {}\nvoid loop() {}\n" if source_kind == "ino" else image.payload
659  +     )
660  +
661  +     class Uploader:
662  +         cleanup_complete = True
663  +
664  +         def reset_cancel(self):
665  +             pass
666  +
667  +         def compile(self, selected, operation, *, deadline_ns):
668  +             events.append(("compile", operation.command_id, deadline_ns))
669  +             return image
