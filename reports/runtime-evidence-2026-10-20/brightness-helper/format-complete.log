282  +     controller: tuple[int, CredentialStore, ControllerRuntime],
283  + ) -> None:
284  +     port, store, _runtime = controller
285  +     first = store.provision_client("cli")
286  +     second = store.provision_client("cli")
287  +     async with loopback_channel(port, 16_777_216) as channel:
288  +         a, b = HeadlessClient(channel, first), HeadlessClient(channel, second)
289  +         async with a.control():
290  +             old = a.operator_command()
291  +             with pytest.raises(ClientError, match="held"):
292  +                 async with b.control():
293  +                     pytest.fail("control was acquired without explicit takeover")
294  +             async with b.control(takeover=True):
295  +                 stale = await a.stub.Setup(old, metadata=first.metadata(), timeout=2)
296  +                 assert stale.result == pb.COMMAND_RESULT_REJECTED
297  +                 with pytest.raises(
298  +                     ClientError, match="registered|unavailable|validator"
299  +                 ) as rejected:
300  +                     await b.execute("Setup")
301  +                 assert rejected.value.command_id
302  +                 assert not rejected.value.admission_uncertain
303  +                 snapshot = await b.get_snapshot()
304  +                 assert snapshot.session.phase == pb.SESSION_PHASE_CONFIGURATION
305  +                 assert not snapshot.session.activated
306  +                 assert snapshot.control.holder_client_id == second.generation
307  +                 # Closing the displaced holder's exact stream must not revoke
308  +                 # the replacement holder or disturb the controller's lifecycle.
309  +                 a._watch.cancel()
310  +                 assert a._reader is not None
311  +                 with pytest.raises(asyncio.CancelledError):
312  +                     await a._reader
313  +                 still_owned = await b.get_snapshot()
314  +                 assert still_owned.control.holder_client_id == second.generation
315  +         result = await b.get_snapshot()
316  +         assert not result.control.HasField("holder_client_id")
317  +     store.remove_client(first)
318  +     store.remove_client(second)
