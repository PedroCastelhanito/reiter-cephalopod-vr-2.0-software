558  + async def test_camera_trigger_rpc_authenticates_exact_peer_and_original_deadline(
559  +     controller,
560  + ):
561  +     from cephvr.acquisition.microcontroller_client import (
562  +         ControllerMicrocontrollerClient,
563  +     )
564  +     from cephvr.shared.transport_deadlines import deadline_metadata
565  +
566  +     port, _store, runtime = controller
567  +     owner, serial = _install_microcontroller(runtime)
568  +     principal = Principal("acquisition", runtime.generation, "camera-trigger-token")
569  +     deadline = runtime.clock() + 5_000_000_000
570  +     request = rpc.MicrocontrollerIoRequest(
571  +         command_id=str(uuid4()),
572  +         requester=pb.ProcessIdentity(role="acquisition", generation=runtime.generation),
573  +         controller_generation=runtime.generation,
574  +         deadline_monotonic_ns=deadline,
575  +         kind=rpc.MICROCONTROLLER_IO_KIND_CONNECT,
576  +         requested=owner.settings.pulses,
577  +     )
578  +     request.claim_id = request.command_id
579  +     async with loopback_channel(port, 16_777_216) as channel:
580  +         stub = wire.ExperimentControllerServiceStub(channel)
581  +         for credential in [
582  +             Principal("acquisition", runtime.generation, "forged"),
583  +             Principal("acquisition", str(uuid4()), principal.token),
584  +         ]:
585  +             with pytest.raises(grpc.aio.AioRpcError) as caught:
586  +                 await stub.ExecuteMicrocontrollerIo(
587  +                     request,
588  +                     metadata=(*credential.metadata(), deadline_metadata(deadline)),
589  +                     timeout=2,
590  +                 )
591  +             assert caught.value.code() == grpc.StatusCode.UNAUTHENTICATED
592  +         with pytest.raises(grpc.aio.AioRpcError) as mismatch:
593  +             await stub.ExecuteMicrocontrollerIo(
594  +                 request,
595  +                 metadata=(*principal.metadata(), deadline_metadata(deadline - 1)),
596  +                 timeout=2,
597  +             )
598  +         assert mismatch.value.code() == grpc.StatusCode.INVALID_ARGUMENT
599  +         assert serial.connect.await_count == 0
600  +         result = await stub.ExecuteMicrocontrollerIo(
601  +             request,
602  +             metadata=(*principal.metadata(), deadline_metadata(deadline)),
603  +             timeout=2,
604  +         )
605  +         assert result.succeeded and result.observation.port == "COM8"
606  +         replay = await stub.ExecuteMicrocontrollerIo(
607  +             request,
608  +             metadata=(*principal.metadata(), deadline_metadata(deadline)),
609  +             timeout=2,
610  +         )
611  +         assert replay == result and serial.connect.await_count == 1
612  +         client = ControllerMicrocontrollerClient(
613  +             stub, principal, runtime.generation, lambda: owner.settings.pulses
614  +         )
615  +         client.claim_id = request.claim_id
616  +         boundary, issued = runtime.clock() + 1_000_000, runtime.clock()
617  +         await client.off(
618  +             ("behavioral",),
619  +             scheduled_boundary_ns=boundary,
620  +             stop_issued_ns=issued,
621  +             deadline_ns=deadline,
622  +         )
623  +         call = serial.off.await_args
624  +         assert call.args == ((1,),)
625  +         assert call.kwargs == {
626  +             "scheduled_boundary_ns": boundary,
627  +             "stop_issued_ns": issued,
628  +             "deadline_ns": deadline,
629  +         }
630  +         bad = rpc.MicrocontrollerIoRequest.FromString(request.SerializeToString())
631  +         bad.command_id = str(uuid4())
632  +         bad.kind = rpc.MICROCONTROLLER_IO_KIND_STATUS
633  +         bad.claim_id = str(uuid4())
634  +         rejected = await stub.ExecuteMicrocontrollerIo(
635  +             bad,
636  +             metadata=(*principal.metadata(), deadline_metadata(deadline)),
637  +             timeout=2,
638  +         )
639  +         assert not rejected.succeeded and "claim" in rejected.failure
640  +         await client.close(deadline_ns=deadline)
641  +         assert not owner.acquisition_claimed and owner.cleanup_complete
