321  + async def test_pending_setup_cancel_and_prompt_response_are_independent_loopback_commands(
322  +     controller: tuple[int, CredentialStore, ControllerRuntime],
323  +     monkeypatch: pytest.MonkeyPatch,
324  + ) -> None:
325  +     from tests.controller.support_components import _RetainedPeer
326  +
327  +     from cephvr.controller.ports import BackendPort
328  +
329  +     port, store, runtime = controller
330  +     principal = store.provision_client("gui")
331  +     backend_context = pb.BackendContext(
332  +         backend_name="visual_stimulus", backend_generation=str(uuid4())
333  +     )
334  +     runtime.setup_admission.backends = {
335  +         "visual_stimulus": cast(
336  +             BackendPort, _RetainedPeer(backend_context, rpc.RetainedResult())
337  +         )
338  +     }
339  +     runtime.supervisor_state.processes["visual_stimulus"] = rpc.ProcessHealthStatus(
340  +         process=pb.ProcessIdentity(
341  +             role="visual_stimulus", generation=backend_context.backend_generation
342  +         ),
343  +         process_running=True,
344  +         connected=True,
345  +     )
346  +     runtime.setup_admission.validators = {
347  +         "structural": lambda _: pb.ValidationResult(completed=True, valid=True)
348  +     }
349  +     runtime.setup_admission.file_policy_loader = lambda _active: {}
350  +     entered, release = asyncio.Event(), asyncio.Event()
351  +
352  +     async def pending_setup(*_args: object) -> None:
353  +         entered.set()
354  +         await release.wait()
355  +
356  +     monkeypatch.setattr(runtime.setup_execution, "run_setup", pending_setup)
357  +     async with loopback_channel(port, 16_777_216) as channel:
358  +         client = HeadlessClient(channel, principal, rpc_timeout_s=3)
359  +         async with client.observe():
360  +             await client.claim_control()
361  +             from cephvr.gui.controller_bridge import ControllerBridge
362  +
363  +             bridge = ControllerBridge(principal, port, 16_777_216, (0,))
364  +             bridge._loop = asyncio.get_running_loop()
365  +             bridge._queue = asyncio.PriorityQueue(maxsize=33)
366  +             bridge._connected = True
367  +             bridge._connection_epoch = 1
368  +             bridge._controller_generation = runtime.generation
369  +             admissions: list[tuple[str, str]] = []
370  +             completions: list[tuple[str, str, str, str]] = []
371  +             progress: list[tuple[str, str]] = []
372  +             bridge.action_progress.connect(
373  +                 lambda action, message: progress.append((action, message))
374  +             )
375  +             admission_event, completion_event = asyncio.Event(), asyncio.Event()
376  +
377  +             def on_admitted(action: str, command_id: str) -> None:
378  +                 admissions.append((action, command_id))
379  +                 admission_event.set()
380  +
381  +             def on_finished(
382  +                 action: str, command_id: str, status: str, message: str
383  +             ) -> None:
384  +                 completions.append((action, command_id, status, message))
385  +                 completion_event.set()
386  +
387  +             bridge.command_admitted.connect(on_admitted)
388  +             bridge.operation_finished.connect(on_finished)
389  +             command_task = asyncio.create_task(bridge._commands(client))
390  +             accepted_configuration = client.snapshot.configuration_values.current
391  +             assert bridge.request(
392  +                 "Setup",
393  +                 expected_revision=client.snapshot.configuration_values.revision,
394  +                 expected_configuration=accepted_configuration.SerializeToString(
395  +                     deterministic=True
396  +                 ),
397  +             )
398  +             await asyncio.wait_for(entered.wait(), 2)
399  +             while not any(action == "Setup" for action, _ in admissions):
400  +                 admission_event.clear()
401  +                 await asyncio.wait_for(admission_event.wait(), 2)
402  +             setup_id = next(
403  +                 command_id for action, command_id in admissions if action == "Setup"
404  +             )
405  +             current = next(
406  +                 item
407  +                 for item in client.snapshot.operations
408  +                 if item.context.command_id == setup_id
409  +             )
410  +             assert not current.complete
411  +
412  +             assert bridge.request("Cancel Setup")
413  +             while not any(action == "Cancel Setup" for action, _ in admissions):
414  +                 admission_event.clear()
415  +                 await asyncio.wait_for(admission_event.wait(), 2)
416  +             cancel_id = next(
417  +                 command_id
418  +                 for action, command_id in admissions
419  +                 if action == "Cancel Setup"
420  +             )
421  +             assert cancel_id != setup_id
422  +             # The Setup coroutine is still blocked behind this gate. Its
423  +             # operation may already be failed by the independently admitted
424  +             # cancellation cleanup, which is the expected safety response.
425  +             assert not release.is_set()
426  +             release.set()
427  +             while not {
428  +                 ("Cancel Setup", cancel_id),
429  +                 ("Setup", setup_id),
430  +             } <= {(action, command_id) for action, command_id, _, _ in completions}:
431  +                 completion_event.clear()
432  +                 await asyncio.wait_for(completion_event.wait(), 3)
433  +             assert (
434  +                 next(
435  +                     status
436  +                     for action, command_id, status, _ in completions
437  +                     if action == "Setup" and command_id == setup_id
438  +                 )
439  +                 == "failed"
440  +             )
441  +             # No backend work exists before supervisor registration, so the
442  +             # cancellation itself confirms cleanup.
443  +             assert (
444  +                 next(
445  +                     status
446  +                     for action, command_id, status, _ in completions
447  +                     if action == "Cancel Setup" and command_id == cancel_id
448  +                 )
449  +                 == "completed"
450  +             )
451  +
452  +             prompt = pb.Prompt(
453  +                 prompt_id=str(uuid4()),
454  +                 setup=pb.SessionContext(
455  +                     controller_generation=runtime.generation, session_id=str(uuid4())
456  +                 ),
457  +                 operation=pb.OperationContext(command_id=str(uuid4())),
458  +                 explanation="A recovery choice is required.",
459  +                 permitted_choices=["recover", "delete"],
460  +             )
461  +             recovery_gate = asyncio.Event()
462  +
463  +             async def wait_for_recovery_choice(choice: str) -> None:
464  +                 assert choice == "delete"
465  +                 await recovery_gate.wait()
466  +
467  +             await runtime.install_startup_recovery(
468  +                 prompt,
469  +                 wait_for_recovery_choice,
470  +                 "pending recovery choice",
471  +             )
472  +             await asyncio.wait_for(
473  +                 client._wait(
474  +                     lambda state: any(
475  +                         item.prompt_id == prompt.prompt_id for item in state.prompts
476  +                     )
477  +                 ),
478  +                 2,
479  +             )
480  +             assert bridge.request(
481  +                 "respond_prompt",
482  +                 prompt=prompt.SerializeToString(),
483  +                 choice="delete",
484  +             )
485  +             recovery_gate.set()
486  +             while not any(
487  +                 action == "respond_prompt" and status == "completed"
488  +                 for action, _, status, _ in completions
489  +             ):
490  +                 completion_event.clear()
491  +                 await asyncio.wait_for(completion_event.wait(), 2)
492  +             assert (
493  +                 progress.count(
494  +                     ("respond_prompt", "Recovery · Unfinished session files deleted.")
495  +                 )
496  +                 == 1
497  +             )
498  +             assert bridge.request("quit")
499  +             await asyncio.wait_for(command_task, 2)
500  +     store.remove_client(principal)
