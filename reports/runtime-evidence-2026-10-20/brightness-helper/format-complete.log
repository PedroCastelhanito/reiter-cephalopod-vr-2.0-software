211  + async def test_spikeglx_timeout_does_not_start_a_second_native_call(
212  +     monkeypatch: pytest.MonkeyPatch,
213  + ) -> None:
214  +     entered, release = threading.Event(), threading.Event()
215  +
216  +     def blocked(_root: Path) -> rpc.SpikeGLXConnectionResult:
217  +         entered.set()
218  +         release.wait(1)
219  +         return rpc.SpikeGLXConnectionResult(connected=True)
220  +
221  +     monkeypatch.setattr("cephvr.synchronization.diagnostic._read_once", blocked)
222  +     diagnostic = SpikeGLXDiagnostic(Path.cwd(), timeout_s=0.01)
223  +     try:
224  +         first = await diagnostic.check()
225  +         assert entered.is_set()
226  +         assert "timed out" in first.error
227  +         second = await diagnostic.check()
228  +         assert "previous" in second.error
229  +     finally:
230  +         release.set()
