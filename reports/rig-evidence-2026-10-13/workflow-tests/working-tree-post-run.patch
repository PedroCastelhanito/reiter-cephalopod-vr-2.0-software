+    assert calls[0][1]["preset"] == "new.pfs"
+    assert calls[0][1]["clock"] == "Internal clock"
+    assert calls[0][1]["kind"] == (
+        rpc.CAMERA_COMMAND_KIND_START_PREVIEW
