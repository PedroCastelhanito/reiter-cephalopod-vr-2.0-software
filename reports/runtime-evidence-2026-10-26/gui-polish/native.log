                assert first.editing_label.text() == "Editing"
                assert (
                    first.grab().toImage().pixelColor(8, 8).name()
                    == colors_for(first).projector_edit
                )
                if cancel:
                    QTest.keyClick(popup, Qt.Key.Key_Escape)
                elif popup_kind == "combo":
