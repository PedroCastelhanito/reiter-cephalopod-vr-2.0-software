        stream = io.BytesIO()
        tifffile.imwrite(stream, pixels, photometric="rgb")
        raw = stream.getvalue()
        asset = Asset(
            asset_id="still",
            logical_path="still.tif",
            profile="tiff_uint_v1",
            color_override=ColorOverride(
                transfer="linear",
                primaries="rec709_d65",
                range="full",
                matrix="rgb",
                chroma_location="none",
                reason="residency test",
            ),
        )
    
