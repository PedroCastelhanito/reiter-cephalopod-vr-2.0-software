{
  "$defs": {
    "ComponentProvenance": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "renderer",
            "shader",
            "image_decoder",
            "video_decoder",
            "arena_importer",
            "color_transform",
            "graphics_driver",
            "gpu",
            "os"
          ],
          "title": "Role",
          "type": "string"
        },
        "implementation": {
          "title": "Implementation",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Content Sha256"
        }
      },
      "required": [
        "role",
        "implementation",
        "version",
        "content_sha256"
      ],
      "title": "ComponentProvenance",
      "type": "object"
    },
    "Fingerprint": {
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Resource Id",
          "type": "string"
        },
        "logical_path": {
          "title": "Logical Path",
          "type": "string"
        },
        "subresource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subresource"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "resource_id",
        "logical_path",
        "subresource",
        "sha256",
        "bytes"
      ],
      "title": "Fingerprint",
      "type": "object"
    },
    "Interpretation": {
      "additionalProperties": false,
      "properties": {
        "interpretation_id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Interpretation Id",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "source_component_bits": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "title": "Source Component Bits",
          "type": "array"
        },
        "pixel_format": {
          "title": "Pixel Format",
          "type": "string"
        },
        "channel_order": {
          "items": {
            "type": "string"
          },
          "title": "Channel Order",
          "type": "array"
        },
        "row_origin": {
          "enum": [
            "top_left",
            "bottom_left"
          ],
          "title": "Row Origin",
          "type": "string"
        },
        "source_alpha": {
          "enum": [
            "none",
            "straight",
            "associated"
          ],
          "title": "Source Alpha",
          "type": "string"
        },
        "transfer": {
          "enum": [
            "linear",
            "srgb",
            "bt709"
          ],
          "title": "Transfer",
          "type": "string"
        },
        "primaries": {
          "const": "rec709_d65",
          "title": "Primaries",
          "type": "string"
        },
        "range": {
          "enum": [
            "full",
            "limited"
          ],
          "title": "Range",
          "type": "string"
        },
        "matrix": {
          "enum": [
            "rgb",
            "bt601",
            "bt709"
          ],
          "title": "Matrix",
          "type": "string"
        },
        "chroma_location": {
          "enum": [
            "none",
            "left",
            "center",
            "topleft"
          ],
          "title": "Chroma Location",
          "type": "string"
        },
        "orientation_degrees": {
          "enum": [
            0,
            90,
            180,
            270
          ],
          "title": "Orientation Degrees",
          "type": "integer"
        },
        "mirror_x": {
          "title": "Mirror X",
          "type": "boolean"
        },
        "sample_aspect_numerator": {
          "exclusiveMinimum": 0,
          "title": "Sample Aspect Numerator",
          "type": "integer"
        },
        "sample_aspect_denominator": {
          "exclusiveMinimum": 0,
          "title": "Sample Aspect Denominator",
          "type": "integer"
        },
        "resolution_origin": {
          "enum": [
            "source_metadata",
            "explicit_override",
            "gltf_base_color"
          ],
          "title": "Resolution Origin",
          "type": "string"
        },
        "effective_override_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effective Override Reason"
        }
      },
      "required": [
        "interpretation_id",
        "width",
        "height",
        "source_component_bits",
        "pixel_format",
        "channel_order",
        "row_origin",
        "source_alpha",
        "transfer",
        "primaries",
        "range",
        "matrix",
        "chroma_location",
        "orientation_degrees",
        "mirror_x",
        "sample_aspect_numerator",
        "sample_aspect_denominator",
        "resolution_origin",
        "effective_override_reason"
      ],
      "title": "Interpretation",
      "type": "object"
    },
    "Resource": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "$ref": "#/$defs/Fingerprint"
        },
        "kind": {
          "enum": [
            "image",
            "video",
            "arena",
            "geometry",
            "photometric",
            "shader"
          ],
          "title": "Kind",
          "type": "string"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "dependencies": {
          "items": {
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "interpretation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interpretation"
            },
            {
              "type": "null"
            }
          ]
        },
        "cpu_bytes": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Cpu Bytes",
          "type": "integer"
        },
        "gpu_bytes": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Gpu Bytes",
          "type": "integer"
        },
        "provider_compatibility": {
          "title": "Provider Compatibility",
          "type": "string"
        }
      },
      "required": [
        "fingerprint",
        "kind",
        "profile_id",
        "dependencies",
        "interpretation",
        "cpu_bytes",
        "gpu_bytes",
        "provider_compatibility"
      ],
      "title": "Resource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/Resource"
      },
      "title": "Resources",
      "type": "array"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ComponentProvenance"
      },
      "title": "Provenance",
      "type": "array"
    }
  },
  "required": [
    "format_version",
    "resources",
    "provenance"
  ],
  "title": "ResourceManifest",
  "type": "object"
}
