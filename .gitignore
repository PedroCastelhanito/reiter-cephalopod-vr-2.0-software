# Local development environments and Python tooling.
/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
/htmlcov/

# Reproducible packaging outputs.
/build/
/dist/
/src/cephvr/acquisition/camera/_pylon_wait_binding*.pyd
/src/cephvr/acquisition/camera/pylon_wait_binding.py
*.egg-info/

# Generated bindings; source schemas remain in contracts/.
/src/cephvr/**/*_pb2.py
/src/cephvr/**/*_pb2.pyi
/src/cephvr/**/*_pb2_grpc.py

# Mutable local history and recordings, not operator defaults or evidence reports.
/config/last_configuration.json
/config/review_draft.json
/cephvr-data/
/.local-spikeglx-sdk/
/.local-spikeglx-pytest/
/.local-spikeglx-rpc-*/

# Disposable rig-test fixtures and SDK/build investigations.
/.tmp/
/.local-calibration-pytest/
/.local-camera-*/
/.local-gui-*/
/.local-mcu-*/
/.local-runtime-*/
/.local-startup-*/
/.pytest-gui-*/
/.tpend*/
/.tpreview*/
/.tlegacy*/
/.tmp-pylon-*/
/pytest-cache-files-*/
/scratch-mcu-*/

