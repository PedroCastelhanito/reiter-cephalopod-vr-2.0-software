# Local development environments and Python tooling.
/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
/.pytest-*/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
/htmlcov/

# Reproducible packaging outputs.
/build/
/dist/
/src/cephvr/**/*.pyd
/src/cephvr/**/*.dll
/src/cephvr/acquisition/camera/pylon_wait_binding.py
*.egg-info/

# Generated bindings; source schemas remain in contracts/.
/src/cephvr/**/*_pb2.py
/src/cephvr/**/*_pb2.pyi
/src/cephvr/**/*_pb2_grpc.py

# Mutable local history and recordings, not operator defaults or evidence reports.
/config/last_configuration.json
/config/review_draft.json
/config/runtime_gui.json
/cephvr-data/

# Images/videos are local assets or evidence, never repository content.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tif
*.tiff
*.svg
*.ico
*.avif
*.heic
*.mp4
*.m4v
*.mkv
*.mov
*.avi
*.webm
*.mpeg
*.mpg
*.wmv

# Captured run datasets and reproducible binaries remain local.
/reports/**/recordings/
/reports/**/*.whl
/reports/**/*.tar.gz
/reports/**/*.zip
/reports/**/*.elf
/reports/**/*.eep
/reports/**/*.bin
/reports/**/*.pid
/reports/**/*.lock

# Historical one-shot edits; current source and assessed results are authoritative.
/reports/device-connection-evidence-2026-10-06/patch_legacy_camera_start.py
/reports/device-connection-evidence-2026-10-06/restore_legacy_runtime_access.py
