{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CephVR: Review GUI (simulated)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/start_gui.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "subProcess": false
    },
    {
      "name": "CephVR: Runtime GUI (managed)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/start_runtime_gui.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "subProcess": false
    }
  ]
}
